// Numerical check for the emitted RK4 loop and the recorder. Batch mode, so
// the suite does not spend wall-clock time spinning at frame boundaries.
sim Decay {
    root: decay.Decay {
        k = 2.0;
    };

    step:     1 (ms);
    solver:   rk4;
    duration: 2 (s);

    record: {
        file:  "decay.csv";
        every: 100;          // 10 Hz in the file, off a 1 kHz base step
        signals {
            x;               // a bare name: legal because it is unambiguous
            out.value;
            out.remaining;
        }
    }
}
