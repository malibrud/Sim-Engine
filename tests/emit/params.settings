// An override that lands on nothing (SE0460) — the silent-typo case, which is
// the worst possible failure for the layer that parameter sweeps generate.
needy.masss = 400 (kg);

// An override whose value is dimensionally wrong for its target (SE0410).
total_mass  = 12 (m);

// The same, but the only thing binding a required setting: still just SE0410.
overridden.mass = 3 (m);
