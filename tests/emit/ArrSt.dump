// ArrSt: how the run is configured (section 14.1): every setting and initial
// condition, then the run's length, the recording, the log and the inputs.

// settings
n     = 3;
k0    = 1 (1/s);

// initial conditions
total = 0;
tick  = 0;
x[1]  = 2;

// the run (section 13.3)
sim.duration = 2 (s);

// the recording (section 13.5)
record {
    clear;
    file  = "arrst.csv";
    every = 100;
    state.x[0];
    state.x[1];
    state.x[2];
    total;
    state.h[0];
    state.h[2];
    tick;
    out.sum;
    out.tail;
}

// the log (section 13.7)
log {
    file  = "";
    level = info;
}

// the inputs (section 13.8)
inputs {
    file = "";
}
