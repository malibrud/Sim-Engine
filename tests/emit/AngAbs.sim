// §4.5 — angle absorbed into a positive power of length. See
// lib/angabs/AngAbs.se for the wires that need the rule and the expected values.
sim AngAbs {
    root: angabs.AngAbs {};

    step:     1 (ms);
    duration: 3 (ms);

    record: {
        file: "angabs.csv";
        signals {
            wxr.y.x;  wxr.y.y;  wxr.y.z;
            acc2.y.x; acc2.y.y; acc2.y.z;
            ta.aout.x; ta.aout.y; ta.aout.z;
            hold.y;
        }
    }
}
