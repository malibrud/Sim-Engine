# ----------------------------------------------------------------------------
#  GENERATED — DO NOT EDIT.
#  Unit manifest for: ContBq.hpp
#  sim: ContBq   root: contbq.ContBq   base step: 0.001 s
#
#  Units are checked by the DSL compiler at every declarative site and then
#  ERASED — the generated C++ is plain `double` throughout. This file is where
#  the erased information goes. It is a real generator output, not
#  documentation: it is the contract for anyone writing an external solver,
#  feeding the root boundary, or overriding a setting from outside the model.
#
#  Every value named here is IN THE UNIT SHOWN. `-` means dimensionless.
# ----------------------------------------------------------------------------

[state.continuous]        # slot | model path | unit  -- the solver's ABI
x[0]      lp.w                    -
xd[0]     lp.w'                   1/s
x[1]      lp.wd                   -
xd[1]     lp.wd'                  1/s
x[2]      hp.w                    -
xd[2]     hp.w'                   1/s
x[3]      hp.wd                   -
xd[3]     hp.wd'                  1/s
x[4]      bq3.x.w                 -
xd[4]     bq3.x.w'                1/s
x[5]      bq3.x.wd                -
xd[5]     bq3.x.wd'               1/s
x[6]      bq3.y.w                 -
xd[6]     bq3.y.w'                1/s
x[7]      bq3.y.wd                -
xd[7]     bq3.y.wd'               1/s
x[8]      bq3.z.w                 -
xd[8]     bq3.z.w'                1/s
x[9]      bq3.z.wd                -
xd[9]     bq3.z.wd'               1/s

[state.discrete]          # Sim::Impl::dis; offsets from Sim::Impl::discrete_map()
          (none)

[signals]                 # Sim::Impl::sig; offsets from Sim::Impl::signal_map()
          src.u                   -           double
          lp.y                    -           double
          hp.y                    -           double
          bq3.sp.x                -           double
          bq3.sp.y                -           double
          bq3.sp.z                -           double
          bq3.mg.v.x              -           double
          bq3.mg.v.y              -           double
          bq3.mg.v.z              -           double
          bq3.x.y                 -           double
          bq3.y.y                 -           double
          bq3.z.y                 -           double
          src3.v.x                -           double
          src3.v.y                -           double
          src3.v.z                -           double

[boundary.in]             # root inputs the host must drive, through Sim::inputs()
          (none)

[boundary.out]            # root outputs the host may read
          lp.y                    -
          hp.y                    -

[settings]                # configurable; value is the elaborated default
          lp.A.c2                 -           = 1.0
          lp.A.c1                 -           = 2.0
          lp.A.c0                 -           = 4.0
          lp.B.c2                 -           = 0.0
          lp.B.c1                 -           = 0.0
          lp.B.c0                 -           = 4.0
          hp.A.c2                 -           = 1.0
          hp.A.c1                 -           = 2.0
          hp.A.c0                 -           = 4.0
          hp.B.c2                 -           = 1.0
          hp.B.c1                 -           = 0.0
          hp.B.c0                 -           = 0.0
          bq3.A.c2                -           = 1.0
          bq3.A.c1                -           = 2.0
          bq3.A.c0                -           = 4.0
          bq3.B.c2                -           = 1.0
          bq3.B.c1                -           = 0.0
          bq3.B.c0                -           = 0.0
          bq3.x.A.c2              -           = 1.0   <- bq3.A.c2
          bq3.x.A.c1              -           = 2.0   <- bq3.A.c1
          bq3.x.A.c0              -           = 4.0   <- bq3.A.c0
          bq3.x.B.c2              -           = 1.0   <- bq3.B.c2
          bq3.x.B.c1              -           = 0.0   <- bq3.B.c1
          bq3.x.B.c0              -           = 0.0   <- bq3.B.c0
          bq3.y.A.c2              -           = 1.0   <- bq3.A.c2
          bq3.y.A.c1              -           = 2.0   <- bq3.A.c1
          bq3.y.A.c0              -           = 4.0   <- bq3.A.c0
          bq3.y.B.c2              -           = 1.0   <- bq3.B.c2
          bq3.y.B.c1              -           = 0.0   <- bq3.B.c1
          bq3.y.B.c0              -           = 0.0   <- bq3.B.c0
          bq3.z.A.c2              -           = 1.0   <- bq3.A.c2
          bq3.z.A.c1              -           = 2.0   <- bq3.A.c1
          bq3.z.A.c0              -           = 4.0   <- bq3.A.c0
          bq3.z.B.c2              -           = 1.0   <- bq3.B.c2
          bq3.z.B.c1              -           = 0.0   <- bq3.B.c1
          bq3.z.B.c0              -           = 0.0   <- bq3.B.c0

[decimation]              # derived from `rate` at configuration

[types]
se.math.Poly3.c2                  -
se.math.Poly3.c1                  -
se.math.Poly3.c0                  -
se.math.Vec3                      units { U }
se.math.Vec3.x                    U
se.math.Vec3.y                    U
se.math.Vec3.z                    U

[recorded]                # columns of contbq.csv
          time                    s
          lp.y                    -
          hp.y                    -
          bq3.vout.x              -
          bq3.vout.y              -
          bq3.vout.z              -
