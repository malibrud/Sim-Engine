// Finite: how the run is configured (section 14.1): every setting and initial
// condition, then the recording and the log.

// settings
cl.accel     = 50 (rad/s^2);
cl.tol       = 3 (rad/s);
pi.kp        = 2;
pi.ki        = 4;
pi.engage_at = 0.995 (s);

// initial conditions
cl.w_clutch  = 0 (rad/s);
cl.locked    = 0;
gb.gear      = 1;
integ.y      = 0;
pi.integ     = 0;
pi.ctl       = MANUAL;
tx.range     = DRIVE;
tx.gear      = 1;

// the recording (section 13.5)
record {
    clear;
    file  = "finite.csv";
    every = 1;
    cl.state.w_clutch;
    cl.state.locked;
    integ.out.y;
    pi.u;
    tx.state.range;
    tx.state.gear;
}

// the log (section 13.7)
log {
    file  = "";
    level = info;
}
