// Array-shaped states (§6.4a) end to end: the dynamic lowering of §15.5a, the
// host-provided state buffers, per-element initial conditions and indexed
// recorded columns. Batch mode, so the suite spends no wall-clock time.
sim ArrSt {
    root: arrst.ArrSt {};

    settings: "arrst.settings";

    step:     1 (ms);
    solver:   rk4;
    duration: 2 (s);

    record: {
        file:  "arrst.csv";
        every: 100;                 // 10 Hz in the file, off a 1 kHz base step
        signals {
            state.x[0];             // an element of a continuous array state
            state.x[1];             // the one an IC override moved
            state.x[2];
            total;                  // a scalar state in the same block
            state.h[0];             // an element of the discrete array block
            state.h[2];
            tick;                   // a scalar discrete state, still in `dis`
            out.sum;
            out.tail;
        }
    }
}
