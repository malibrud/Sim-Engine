package vec3;

use se.math;
use se.sig.ct;

// The v1 vector layer must emit and compile, and the units must come out
// right at every hop. The chain deliberately CHANGES dimension twice, so a
// substitution bug shows up in the manifest rather than only at run time:
//
//   accel (m/s^2) --Scale3(s)--> (m/s) --Split3--> three scalars
//        --ct.Biquad--> three scalars --Merge3--> (m/s)
//
// and separately  omega (rad/s) x arm (m) -> (rad*m/s), the Cross3 assertion.
node Vec3Chk {
    outputs {
        speed:   math.Vec3(m/s);
        mag:     double(m/s);
        tangent: math.Vec3(rad*m/s);
    }

    structure {
        node src : Accel {};

        // (m/s^2) * (s) -> (m/s). One definition, any pair of units.
        node sc : math.Scale3 (m/s^2, s) { k = 0.5; };

        node sp : math.Split3 (m/s) {};
        node lx : ct.Biquad (m/s) { a0 = 1.0; a1 = 2.0; a2 = 4.0;
                                    b0 = 0.0; b1 = 0.0; b2 = 4.0; };
        node ly : ct.Biquad (m/s) { a0 = 1.0; a1 = 2.0; a2 = 4.0;
                                    b0 = 0.0; b1 = 0.0; b2 = 4.0; };
        node lz : ct.Biquad (m/s) { a0 = 1.0; a1 = 2.0; a2 = 4.0;
                                    b0 = 0.0; b1 = 0.0; b2 = 4.0; };
        node mg : math.Merge3 (m/s) {};
        node nm : math.Norm3  (m/s) {};

        // Dimension-changing cross product, one definition for any pair.
        node om : Omega {};
        node arm : Arm {};
        node cr : math.Cross3 (rad/s, m) {};

        src --> sc --> sp;
        sp.x --> lx --> mg.x;
        sp.y --> ly --> mg.y;
        sp.z --> lz --> mg.z;
        mg --> nm, self.speed;
        nm --> self.mag;

        om  --> cr.a;
        arm --> cr.b;
        cr  --> self.tangent;
    }
}

// File-private constant sources. Purely algebraic -- no states.
node Accel {
    outputs { a: math.Vec3(m/s^2); }
    output() { out.a.x = 1.0; out.a.y = 0.0; out.a.z = 0.0; }
}

node Omega {
    outputs { w: math.Vec3(rad/s); }
    output() { out.w.x = 0.0; out.w.y = 0.0; out.w.z = 2.0; }
}

node Arm {
    outputs { r: math.Vec3(m); }
    output() { out.r.x = 3.0; out.r.y = 0.0; out.r.z = 0.0; }
}
