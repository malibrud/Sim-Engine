package params;

// Stage-4 setting diagnostics: a required setting nobody bound (SE0420), and a
// cycle among derived defaults (SE0421).
//
// A required setting that IS bound, but to something that fails to evaluate, is
// reported once for the failure and never again as SE0420: `root_need` from
// params.sim, `overridden.mass` from params.settings.
node Params {
    settings {
        total_mass: double(kg) = 1500.0;
        root_need:  double(-);                    // bound by params.sim, badly
    }
    outputs { y: double(-); }

    structure {
        node needy : Needy {};                    // SE0420: `mass` is required
        node overridden : Needy {};               // bound by params.settings, badly
        node ring  : Ring  {};                    // SE0421

        needy.q --> self.y;
    }
}

node Needy {
    settings { mass: double(kg); }               // no default => required
    outputs  { q: double(-); }
    output() { out.q = param.mass; }
}

node Ring {
    settings {
        a: double(-) = param.b + 1.0;
        b: double(-) = param.c * 2.0;
        c: double(-) = param.a - 1.0;
    }
    outputs  { z: double(-); }
    output() { out.z = param.a; }
}
