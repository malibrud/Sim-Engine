// Angle absorbed into a positive power of length (§4.5). Every wire marked
// ABSORB below joins two units that differ in angle alone, with length on
// both sides, and would be SE0410 without the rule.
//
// The lever-arm acceleration is wired from generic blocks and computed by the
// `se.kin.TranslateAcc` leaf from the same settings, so the two must agree to
// the bit, and the setting flow-down carries `rad*m` into an `(m)` setting:
//
//   w = (0, 0, 2) rad/s     wd = (0, 0, 3) rad/s^2     r = (3, 0, 0) m
//   ain = (1, 1, 1) m/s^2
//
//   wxr  = w x r                          = (  0,  6, 0) m/s
//   acc  = ain + wd x r + w x (w x r)
//        = (1,1,1) + (0,9,0) + (-12,0,0)  = (-11, 10, 1) m/s^2
//   hold = th * rr = 2 rad * 1.5 m        = 3 m
package angabs;

use se.math;
use se.kin;

node AngAbs {
    settings {
        w:   math.Vec3(rad/s)   = { 0.0, 0.0, 2.0 };
        wd:  math.Vec3(rad/s^2) = { 0.0, 0.0, 3.0 };
        r:   math.Vec3(m)       = { 3.0, 0.0, 0.0 };
        ain: math.Vec3(m/s^2)   = { 1.0, 1.0, 1.0 };
        th:  double(rad)        = 2.0;
        rr:  double(m)          = 1.5;
    }

    outputs {
        vel: math.Vec3(m/s);
        acc: math.Vec3(m/s^2);
    }

    structure {
        // w x r is `rad*m/s`; ABSORB into the `(m/s)` boundary.
        node wxr : math.Cross3 (rad/s, m);
        param.w --> wxr.a;
        param.r --> wxr.b;
        wxr     --> self.vel;

        // The tangential term is `rad*m/s^2`, the centripetal one
        // `rad^2*m/s^2`; both ABSORB into the `(m/s^2)` adders.
        node tan  : math.Cross3 (rad/s^2, m);
        node cen  : math.Cross3 (rad/s, rad*m/s);
        node acc1 : math.Sum3 (m/s^2);
        node acc2 : math.Sum3 (m/s^2);
        param.wd  --> tan.a;
        param.r   --> tan.b;
        param.w   --> cen.a;
        wxr       --> cen.b;
        param.ain --> acc1.a;
        tan       --> acc1.b;
        acc1      --> acc2.a;
        cen       --> acc2.b;
        acc2      --> self.acc;

        // The same physics as a leaf, for the agreement check.
        node ta : kin.TranslateAcc (m) { r = param.r; };
        param.ain --> ta.ain;
        param.w   --> ta.w;
        param.wd  --> ta.wd;

        // A `rad*m` expression ABSORBED by an `(m)` setting at flow-down.
        node hold : Hold { len = param.th * param.rr; };
    }
}

node Hold {
    settings { len: double(m); }
    outputs  { y: double(m); }
    output() { out.y = param.len; }
}
