// Exercises the standard library's v1 signal layer end to end, on one unit
// parameter's worth of chain:
//
//   ramp -> ScaleLimit -> Biquad -> Integrator -> Differentiator -> Sum
//   (m/s^2)   (m/s^2)     (m/s^2)     (m/s)          (m/s^2)
//
// It spans all four library packages: the source is `se.sig.src`, `ScaleLimit`
// is memoryless and sits in `se.sig`, the four filters are discrete and sit in
// `se.sig.dt`, and `Sum` is `se.math`.
//
// The units are the check. `dt.Integrator` DERIVES (m/s) and `dt.Differentiator`
// derives back to (m/s^2); the `math.Sum` at the end only type-checks because the
// round trip lands exactly where it started.
package stdchk;

use se.sig;
use se.sig.dt;
use se.sig.src;
use se.math;

node StdChk {
    outputs { y (m/s^2): double; }

    structure {
        node ramp : src.Ramp (m/s^2) { slope = 1.0; };

        // Reid & Nahon Table 5.3 block B12: s^2 / (s^2 + 8.68 s + 9.61).
        node lim : sig.ScaleLimit    (m/s^2) { gain = 1.0; limit = 100.0; };
        node hp  : dt.Biquad         (m/s^2) { a0 = 1.0;  a1 = 8.68;  a2 = 9.61;
                                               b0 = 1.0;  b1 = 0.0;   b2 = 0.0; };
        node acc : dt.Integrator     (m/s^2) {};
        node dif : dt.Differentiator (m/s)   { wc = 12.5; };
        node add : math.Sum          (m/s^2) {};
        // Table 5.3 block B3, by the field's native wn/zeta parameterisation.
        node lp  : dt.LowPass2       (m/s^2) { wn = 3.1; zeta = 1.4; };

        ramp.y --> lim.x;
        lim.y --> lp.x;
        lim.y --> hp.x;
        hp.y  --> acc.x;
        acc.y --> dif.x;
        dif.y --> add.a;
        lim.y --> add.b;
        add.y --> self.y;
    }
}
