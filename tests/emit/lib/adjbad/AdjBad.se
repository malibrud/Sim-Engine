// SPEC 8.3 -- a jump is a `next()`, and its parameter list is checked like any
// other method's. The loop in `check_methods` exempts `init()` and `final(ctx)`
// and nothing else.
package adjbad;

node AdjBad {
    outputs { y: double(-); }

    structure {
        node b : BadParam {};

        1.0 --> b.u;
        b --> self.y;
    }
}

// SE0350: `nosuch` is not a declared input.
node BadParam {
    inputs  { u: double(-); }
    outputs { y: double(-); }

    states { continuous x: double(-) = 0.0; }

    derivative(u) { der.x = in.u; }
    next(nosuch)  { next.x = state.x; }
    output()      { out.y = state.x; }
}
