package frames;

// A minimal model, existing only so a `.sim` with the entries §9.4 removed
// (`mode`, `sync`, `window`) has something to name as its root.
node Frames {
    settings {
        gain: double(-) = 1.0;
    }
    outputs {
        y: double(-);
    }
    states {
        continuous v: double(-) = 1.0;
    }

    derivative()  { der.v = -param.gain * state.v; }
    output() { out.y = state.v; }
}
