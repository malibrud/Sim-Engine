// §6.4c / §9.6 — finite states end to end, one leaf per property, each with a
// closed form so a wrong schedule is a wrong number rather than a plausible
// one. 10 ms base step, rk4.
//
//   cl    THE JUMP. A clutch spins up at 50 rad/s^2 towards a 100 rad/s engine
//         and locks once within 3 rad/s. transition() decides, adjust() snaps
//         the speed, in the same tick. The lock tick's row still reads
//         unlocked at 97.5 (recording precedes the jump); the next row reads
//         locked at exactly 100, and so does every row after it. Only the snap
//         can produce that 100: a locked clutch's derivative is zero, so
//         without it the speed would stay at 97.5.
//
//   gb    NOT HELD. torque = gear * sim.time(), integrated. The gear changes
//         from 1 to 2 at t = 0.5. If this node were held, RK4 would see a
//         staircase and the integral would be off by O(h); because a finite
//         state does not hold its node, the stages see t move and the
//         integral is t^2/2 up to 0.5 and t^2 - 0.125 after, to round-off.
//
//   pi    ENTRY ONLY. A PI controller switches MANUAL -> AUTO at t = 1.0 and
//         presets its integrator once, through `prev.`, so the output does not
//         jump: u = 3 throughout MANUAL and 3 + 2 (t - 1) after. A preset on
//         every AUTO tick would hold u at 3 for good.
//
//   tx    BUFFERED. One transition() moves the range to NEUTRAL at t = 0.5 and
//         picks the gear from `state.range`, which is the OLD range: so the
//         gear drops to 0 one tick after the range moves, whatever order the
//         two statements are in. The write to the range comes first here, the
//         order that would drop them together if the writes were in place.
package fsm;

use se.sig.ct;

finite Ctl   { MANUAL, AUTO }
finite Range { DRIVE, NEUTRAL }

node Finite {
    structure {
        node cl    : Clutch {};
        node gb    : Gearbox {};
        node integ : ct.Integrator (-) {};
        node pi    : Bumpless {};
        node tx    : Box {};

        100.0 --> cl.w_eng;
        gb --> integ;
        0.5 --> pi.err;
        3.0 --> pi.u_manual;
    }
}

node Clutch {
    settings {
        accel: double(rad/s^2) = 50.0;
        tol:   double(rad/s)   = 3.0;
    }
    inputs  { w_eng: double(rad/s); }
    outputs { w: double(rad/s); }
    states {
        continuous w_clutch: double(rad/s) = 0.0;
        finite     locked:   bool          = 0;
    }

    output() { out.w = state.w_clutch; }
    derivative() { der.w_clutch = state.locked ? 0.0 : param.accel; }

    transition(w_eng) {
        if (!state.locked && std::abs(state.w_clutch - in.w_eng) < param.tol)
            transition.locked = true;
    }
    adjust(w_eng) {
        if (state.locked) adjust.w_clutch = in.w_eng;   // the NEW value
    }
}

node Gearbox {
    outputs { tau: double(-); }
    states  { finite gear: int(-) = 1; }

    // Not held, so this runs at every stage and sees the stage's instant.
    output() { out.tau = state.gear * sim.time(); }

    transition() {
        if (sim.time() >= 0.495) transition.gear = 2;
    }
}

node Bumpless {
    settings {
        kp:        double(-) = 2.0;
        ki:        double(-) = 4.0;
        engage_at: double(s) = 0.995;
    }
    inputs  { err: double(-); u_manual: double(-); }
    outputs { u: double(-); }
    states {
        continuous integ: double(-) = 0.0;
        finite     ctl:   Ctl       = MANUAL;
    }

    output(err, u_manual) {
        out.u = state.ctl == Ctl::AUTO ? param.kp * in.err + param.ki * state.integ
                                       : in.u_manual;
    }
    derivative(err) { der.integ = state.ctl == Ctl::AUTO ? in.err : 0.0; }

    transition() {
        transition.ctl = sim.time() >= param.engage_at ? Ctl::AUTO : Ctl::MANUAL;
    }
    adjust(u_manual, err) {
        if (state.ctl == Ctl::AUTO && prev.ctl != Ctl::AUTO)
            adjust.integ = (in.u_manual - param.kp * in.err) / param.ki;
    }
}

node Box {
    states {
        finite range: Range  = DRIVE;
        finite gear:  int(-) = 1;
    }

    transition() {
        transition.range = sim.time() >= 0.495 ? Range::NEUTRAL : Range::DRIVE;
        if (state.range == Range::DRIVE) transition.gear = 3;   // the OLD range
        else                             transition.gear = 0;
    }
}
