// §6.4 / §6.4c / §6.12 — every way a finite state can be misdeclared that
// `sec` must refuse. Each node is wrong in exactly one way.
package fsmbad;

node FsmBad {
    structure {
        node a : Real {};
        node b : Arr {};
        node c : NoTransition {};
        node d : NoFinite {};
        node e : PrevName {};
    }
}

node Real {
    states { finite x: double(-) = 0.0; }    // SE0434 — not finitely valued
    transition() {}
}

node Arr {
    states { finite x [3]: int(-) = 0; }     // SE0433 — a finite state is scalar
    transition() {}
}

node NoTransition {                          // SE0347 — nothing writes `q`
    states { finite q: bool = 0; }
}

node NoFinite {
    states { discrete n: int(-) = 0; }
    next() { next.n = state.n + 1; }
    transition() {}                          // SE0348 — nothing to write
}

node PrevName {
    vars { prev: double(-); }                // SE0331 — `prev` is in scope of adjust()
    on_step() {}
}
