// Numerical check for se.sig.ct.Biquad, the stdlib's first block with
// continuous states. Both sections are driven by the same unit step and both
// have an exact closed form, which is what tests/run.ps1 compares the recorded
// CSV against — the same treatment `decay` gets, rather than a golden file.
//
// The two share poles (wn = 2 rad/s, zeta = 0.5) and differ only in numerator,
// which is how the coefficient paths get covered between them:
//
//   lp:  4 / (s^2 + 2 s + 4)     exercises a1, a2, b2 and the `cw` tap
//   hp:  s^2 / (s^2 + 2 s + 4)   exercises b0 — the direct term and the
//                                corrections it puts on both taps
//
// hp is the sharper of the two: its step response starts at exactly 1, so a
// dropped or mis-signed direct term is wrong in the very first recorded row.
//
// `bq3` is the same assertion for `ct.Biquad3`, whose characteristic bug the
// scalar cases cannot reach: six states and three output taps in one leaf, so a
// cross-wired axis -- `der.wdy` reading `state.wdx`, `out.vout.z` reading `wy`
// -- compiles perfectly and integrates something plausible. It is given hp's
// coefficients and a CONSTANT VECTOR input of {1, 2, 3}, so by linearity each
// axis is hp's own step response scaled by its own component, and the three
// columns are 1x, 2x and 3x each other at every sample. Any axis reading
// another's state or input is off by a whole integer factor, in the first row,
// rather than by something a tolerance might absorb.
package contbq;

use se.math;
use se.sig.ct;

node ContBq {
    outputs {
        lp_y: double(-);
        hp_y: double(-);
    }

    structure {
        node src : Step {};

        node lp : ct.Biquad (-) {
            A = { 1.0, 2.0, 4.0 };
            B = { 0.0, 0.0, 4.0 };
        };
        node hp : ct.Biquad (-) {
            A = { 1.0, 2.0, 4.0 };
            B = { 1.0, 0.0, 0.0 };
        };

        // Same H(s) as `hp`, three axes at once.
        node bq3 : ct.Biquad3 (-) {
            A = { 1.0, 2.0, 4.0 };
            B = { 1.0, 0.0, 0.0 };
        };
        node src3 : Step3 {};

        src --> lp;
        src --> hp;
        src3 --> bq3;

        lp --> self.lp_y;
        hp --> self.hp_y;
    }
}

// File-private: a unit step that is already high at t = 0, so the closed forms
// hold from the first sample. Purely algebraic — no states, so no next().
node Step {
    outputs { u: double(-); }

    output() { out.u = 1.0; }
}

// File-private, and the three components are DELIBERATELY DISTINCT: a vector
// source of {1, 1, 1} would let every axis-crossing bug in `Biquad3` pass.
node Step3 {
    outputs { v: math.Vec3(-); }

    output() {
        out.v.x = 1.0;
        out.v.y = 2.0;
        out.v.z = 3.0;
    }
}
