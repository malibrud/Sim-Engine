package checks;

// Stage-3 consistency rules (§6.11, §6.12) and unit-symbol resolution
// (Appendix A). Each offender is a file-private node, instantiated so that
// resolution actually reaches it.
node Checks {
    outputs { y: double(-); }

    structure {
        node a : BadUnit  {};
        node b : BadState {};
        node c : NoOutput {};
        node d : BadParam {};
        node e : Both     {};
        node f : DegUnit  {};
        node g : OmegaHz  {};
        node h : IdleNext {};
        node i : VecArity {};
        node j : VecSrc   {};
        node k : VecSink  {};

        // SE0410 — one `Vec3`, two bindings whose DIMENSIONS differ. A
        // compatible pair would convert per field (see tests/emit/RecConv.sim);
        // `(m)` into `(m/s)` has nothing to convert, on a record or a scalar.
        j.v --> k.v;

        a.z --> self.y;
    }
}

node BadUnit {
    // SE0414 — `sec` is not a unit; the diagnostic must point at `(s)`.
    settings { period: double(sec) = 1.0; }
    outputs  { z: double(-); }
    output() { out.z = param.period; }
}

node BadState {
    // SE0431 — the solver's ABI is a flat `double` array.
    states  { continuous n: int(-) = 0; }
    derivative() { der.n = 0.0; }
}

node NoOutput {
    // SE0340 — nothing else could compute an output.
    outputs { z: double(-); }
    states  { discrete k: int(-) = 0; }
    next() { next.k = 1; }
}

node IdleNext {
    // SE0345 — `next()` may write only `next.`, and there is no discrete state
    // for it to write. The check only became possible once `on_step()` stopped
    // carrying the equation: while one method did both jobs, a body with no
    // discrete states could still be doing legitimate `var` work.
    outputs { z: double(-); }
    next()   { }
    output() { out.z = 0.0; }
}

// §5.2 — a parametric record binds its units at every REFERENCE, since a type
// is never instantiated. These three exercise the binding's two failure modes.
type Vec3 {
    units { U; }
    x: double(U);
    y: double(U);
    z: double(U);
}

node VecArity {
    // SE0313 — `Vec3` takes one unit argument and is given none.
    inputs   { v: Vec3; }
    outputs  { z: double(-); }
    output(v) { out.z = in.v.x; }
}

node VecSrc {
    outputs  { v: Vec3(m); }
    output() { out.v.x = 0.0; out.v.y = 0.0; out.v.z = 0.0; }
}

node VecSink {
    inputs   { v: Vec3(m/s); }
    outputs  { z: double(-); }
    output(v) { out.z = in.v.x; }
}

node BadParam {
    // SE0350 — the parameter list is exactly the set of inputs the method reads.
    inputs   { u: double(-); }
    outputs  { z: double(-); }
    output(nope) { out.z = 0.0; }
}

node Both {
    // SE0320 — leaf or composite, never both.
    vars { t: double(-); }
    structure { node inner : BadUnit {}; }
}

node DegUnit {
    // SE0415 — radians are the only DECLARABLE angle unit (§4.5). A `(deg)`
    // literal is still fine, because it converts and is gone; a `(deg)`
    // accessor would survive into a body, where units are erased.
    settings { heading: double(deg) = 90.0; }
    outputs  { z: double(-); }
    output() { out.z = param.heading; }
}

node OmegaHz {
    // SE0410 — `(rad/s)` is angle/time and `(Hz)` is 1/time, so they no longer
    // convert. This is the factor-of-2pi mix-up that §4.5 buys.
    settings { f: double(Hz) = 1.0 (rad/s); }
    outputs  { z: double(-); }
    output() { out.z = param.f; }
}
