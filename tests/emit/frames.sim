// SE0265 — the entries real-time pacing used to need. Pacing is the host's now
// (§9.4), so each is reported as removed, with where it went, rather than as
// an unknown entry with a did-you-mean.
sim Frames {
    root:     frames.Frames;
    step:     1 (ms);
    duration: 1 (s);

    mode:     realtime;
    sync:     10 (ms);
    window:   1 (s);
}
