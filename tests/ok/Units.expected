  use se.mech
  node Units  [line 9]  kind=leaf
    settings
      total_mass: double(kg)  [required]
      corner_mass: double(kg) = (param.total_mass / 4.0)
      inertia: double(kg*m^2) = 0.9
      inv_inertia: double(1/(kg*m^2)) = 1.0
      jerk: double(m/s^3) = 0.0
