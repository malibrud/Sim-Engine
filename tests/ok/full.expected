=== tests/ok/full.sim ===
sim-file Full
  root: tests.Vehicle
    total_mass = 1800 (kg)
    ctl_rate = 100.0
  step: 0.5 (ms)
  solver: rk4
  duration: 10 (s)
  settings: "sweep.settings"
  record
    file: "run.csv"
    every: 20
    add front.left.out.force
    add front.left.state.velocity
    add mix.total
    add sim.utilization
    add sim.overrun_pct
  log
    file: "run.log"
    level: info
    level front.left: debug
    level mix: trace
