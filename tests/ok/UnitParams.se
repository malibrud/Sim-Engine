// Unit parameters (§6.2a). A leaf node may be parameterised over a unit; the
// instantiation supplies it positionally, after the definition path.
//
// The chain below is the point of the feature: `hp` preserves its unit, `acc`
// CHANGES it (`U*s`), and the composite's own port is what the product has to
// land on. With U = (m/s^2): m/s^2 -> m/s^2 -> m/s.
package tests;

node UnitParams {
    outputs { y: double(m/s); }

    structure {
        node hp  : Section   (m/s^2) { wn = 3.1; zeta = 1.4; };
        node acc : Integrate (m/s^2) {};

        hp.y  --> acc.x;
        acc.y --> self.y;
    }
}

// Dimension-preserving: a second-order section is `U -> U` whatever U is, and
// its rate tap is one time-derivative down.
node Section {
    units    { U; }
    settings { wn: double(rad/s); zeta: double(-); }
    inputs   { x: double(U); }
    outputs  { y: double(U); y_dot: double(U/s); }
    states   { discrete w1: double(-) = 0.0;
               discrete w2: double(-) = 0.0; }

    output(x)  { out.y = in.x; out.y_dot = 0.0; }
    next(x) { next.w1 = in.x; next.w2 = state.w1; }
}

// Dimension-changing: the output unit is DERIVED from the input's, which is
// what makes mis-wiring a velocity into a position port a hard error.
node Integrate {
    units   { U; }
    inputs  { x: double(U); }
    outputs { y: double(U*s); }
    states  { discrete a: double(-) = 0.0; }

    output()   { out.y = state.a; }
    next(x) { next.a = state.a + in.x; }
}
