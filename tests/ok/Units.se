// Unit-expression and elaboration-expression coverage. SPECIFICATION.md §4.1, §7.
// Nothing here is unit-CHECKED yet — that is stage 4 — but every shape the
// grammar admits must parse and round-trip.
package tests;

use se.mech.Damper;
use se.mech;

node Units {
    settings {
        // Derived settings: an expression over the same node's other settings.
        total_mass:  double(kg);
        corner_mass: double(kg) = param.total_mass / 4.0;

        // Unit shapes.
        inertia:     double(kg*m^2)     = 0.9;
        inv_inertia: double(1/(kg*m^2)) = 1.0;
        jerk:        double(m/s^3)      = 0.0;
        visc:        double(kg/m/s)     = 1.8e-5;
        area_rt:     double(m^(1/2))    = 1.0;
        decay:       double(s^-1)       = 0.5;
        ratio:       double(-)          = 0.25;
        duty:        double(%)          = 40.0;
        // §4.5 — radians are the only declarable angle unit; `(deg)` is legal
        // as the literal's suffix and converts here.
        heading: double(rad) = 90 (deg);

        // A literal may carry its own unit and be converted at elaboration.
        limit: double(m/s) = 130 (km/h);

        // The full expression language: precedence, builtins, constants.
        omega:  double(rad/s) = 2.0 * pi * 50.0;
        diag:   double(m)     = hypot(3.0, 4.0);
        scaled: double(m)     = -2.0^2 + max(1.0, 2.0) / (3.0 - 1.0);
        rooted: double(m)     = sqrt(param.corner_mass / 4.0) * 1.0;
        flat:   double(-)     = 2.0^3.0^2.0;
    }
    outputs {
        y: double(-);
    }

    output() { out.y = param.ratio; }
}
