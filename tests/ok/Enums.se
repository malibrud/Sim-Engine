// §5.2a — finite-type declarations as the parser records them: C numbering, an
// explicit value that restarts it, a negative value, a trailing comma, and an
// annotation-free private one beside the public one.
package device;

finite Enums {
    IDLE, CONNECTING, CONNECTED,
    FAULT = 15, RECOVERING,
    LOW = -2, LOWER,
}

finite Retry { NEVER, ALWAYS = 9 }
