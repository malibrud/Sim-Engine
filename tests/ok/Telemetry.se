// A record type, including a nested record and a bool field. §5.2.
package tests;

type Telemetry {
    torque (N*m): double;   // scalar field
    ok     (-):   bool;     // bool must be dimensionless
    stamp: Sample;          // a record field: same line shape, two forms
}

// File-private record.
type Sample {
    t (s): double;
    n (-): int;
}
