// The `sec --doc` fixture: one of everything the generator renders for a
// node. `//` comments like this one are source notes and are not published.
package docfix;

use docfix;

/// Follows its input through a first-order lag.
///
///     d/dt y = (vin - y) / tau
///
/// The output approaches a constant input exponentially, reaching 63 % of a
/// step after `tau` (§6.4).
///
/// # Initial conditions
/// `y` starts at zero unless overridden.
///
/// # Limitations
/// `tau` must be positive; zero divides by zero.
///
/// # See also
/// `Pair`, for a record this node does not use.
node Lag {
    units { U; }   /// unit of the signal

    settings {
        tau: double(s) = 0.5;   /// time constant
        gain: double(-);        /// scale applied to the output
    }

    inputs  {
        vin: double(U);         /// signal to follow
    }
    outputs {
        vout: double(U);        /// lagged signal, scaled by `gain`
    }

    states {
        continuous y: double(U) = 0.0;   /// lagged signal before scaling
    }

    // A source-only note: the derivative reads `vin`, `output()` does not.
    derivative(vin) { der.y = (in.vin - state.y) / param.tau; }
    output() { out.vout = param.gain * state.y; }

    tests {
        units { U = m; }

        set "the output is the state times the gain", param.gain, state.y = out.vout {
            2, 3, 6, "doubles";
            0, 3, 0, "zero gain";
        }

        set "the state moves toward the input", param.tau, state.y, in.vin ~= der.y within 1e-12 {
            0.5, 0, 1, 2, "a unit step at rest";
        }
    }
}

// A private helper: not documented, and not required to be.
node Unused {
    outputs { z: double(-); }
    output() { out.z = 0.0; }
}
