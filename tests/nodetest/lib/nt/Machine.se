// SPECIFICATION 6.4 / 6.13 -- one next() over two kinds of state. A `next.`
// column checks what the body wrote: the mode, and the integrator it presets.
// `state.` is the GIVEN value throughout, which is how the bumpless preset
// fires only on the row whose given state is not already AUTO.
package nt;

finite Ctl { MANUAL, AUTO }

node Machine {
    settings { kp: double(-) = 2.0; ki: double(-) = 4.0; }
    inputs   { engage: bool; err: double(-); u_manual: double(-); }
    states {
        continuous integ: double(-) = 0.0;
        finite     ctl:   Ctl       = MANUAL;
    }

    derivative(err) { der.integ = state.ctl == Ctl::AUTO ? in.err : 0.0; }
    next(engage, u_manual, err) {
        next.ctl = in.engage ? Ctl::AUTO : Ctl::MANUAL;
        if (in.engage && state.ctl != Ctl::AUTO)
            next.integ = (in.u_manual - param.kp * in.err) / param.ki;
    }

    tests {
        step: 1 (ms);

        set "engage moves the controller", state.ctl, in.engage = next.ctl {
            MANUAL, 1, AUTO,   "engaged";
            AUTO,   0, MANUAL, "released";
        }
        set "the preset fires on entry only", state.ctl, state.integ, in.engage, in.err,
            in.u_manual = next.integ {
            MANUAL, 0.0, 1, 0.5, 3.0, 0.5, "entering AUTO presets the integrator";
            AUTO,   7.0, 1, 0.5, 3.0, 7.0, "already AUTO: left to integrate";
            MANUAL, 7.0, 0, 0.5, 3.0, 7.0, "staying MANUAL: untouched";
        }
    }
}
