// The continuous realization of one second-order section: the same H(s) the
// discrete `Biquad` takes, integrated by the global solver instead of mapped
// through the bilinear transform.
//
// `Biquad` takes ANALOG coefficients precisely so that a continuous realization
// could consume the identical spec, and this is it. The two nodes have the same
// six settings and the same U -> U ports, so moving a block between them is a
// change of node path and nothing else.
//
// Reach for this one when the filter is part of the plant rather than part of
// the signal processing: its states join the solver's state vector, so they are
// integrated at the solver's order alongside the dynamics they interact with,
// and a stiff section is the step size's problem rather than a design that was
// silently warped. Reach for `Biquad` when you want a fixed-rate filter whose
// coefficients are pinned once and whose response does not move when the sim's
// step or solver changes.
//
// Instantiate this directly to enter H(s) yourself:
//
//     node hp : se.signal.ContinuousBiquad (m/s^2) {
//         a0 = 1.0;  a1 = 8.68;  a2 = 9.61;      // s^2 + 8.68 s + 9.61
//         b0 = 1.0;  b1 = 0.0;   b2 = 0.0;       // s^2          -> high-pass
//     };
package se.signal;

node ContinuousBiquad {
    units { U; }

    settings {
        // H(s) = (b0 s^2 + b1 s + b2) / (a0 s^2 + a1 s + a2).
        //
        // Declared `(-)` because a continuous coefficient array has per-element
        // units — a1 is T^-1, a2 is T^-2 — which there is no honest way to
        // spell. The dimensional contract lives entirely in the ports: this
        // node is U -> U, and nothing about the coefficients can change that.
        //
        // Identical to `Biquad`'s, deliberately: the shared surface is what
        // makes the two interchangeable.
        a0 (-): double = 1.0;
        a1 (-): double = 0.0;
        a2 (-): double = 0.0;
        b0 (-): double = 0.0;
        b1 (-): double = 0.0;
        b2 (-): double = 1.0;

        // NO `fs`, and no `rate`. There is no discretization here, so there is
        // no sample rate to design against — the one setting that separates
        // this node from `Biquad` is the one that is missing. Accuracy is the
        // sim file's `step` and `solver`, and a continuous node is by
        // definition a base-rate node that happens to have integrated states.
    }

    inputs  { x (U): double; }
    outputs { y (U): double; }

    // Controllable canonical form: `w` is the inner state, `wd` its derivative.
    // Two states whatever the section is; a first-order design does NOT belong
    // here — see Integrator, Differentiator and HighPass1.
    //
    // `(-)` for the same reason Biquad's Direct Form II states are: a canonical
    // form state has no honest unit when the coefficients carry none. Note that
    // these names are public surface — they are the slot map in
    // `[state.continuous]` and the path an initial condition overrides.
    states {
        continuous w  (-): double = 0.0;
        continuous wd (-): double = 0.0;
    }

    vars {
        n1 (-): double;  n2 (-): double;     // denominator, normalised by a0
        d0 (-): double;                      // direct term
        cw (-): double;  cwd (-): double;    // output taps on w and wd
    }

    // Normalise by a0 once, so neither derivative() nor output() carries a division.
    //
    //     w'  = wd
    //     wd' = u - n1 wd - n2 w
    //     y   = d0 u + (m1 - d0 n1) wd + (m2 - d0 n2) w
    init() {
        const double inv = 1.0 / param.a0;
        var.n1 = param.a1 * inv;
        var.n2 = param.a2 * inv;

        const double m1 = param.b1 * inv;
        const double m2 = param.b2 * inv;

        var.d0  = param.b0 * inv;
        var.cwd = m1 - var.d0 * var.n1;
        var.cw  = m2 - var.d0 * var.n2;
    }

    derivative(x) {
        der.w  = state.wd;
        der.wd = in.x - var.n1 * state.wd - var.n2 * state.w;
    }

    // Feedthrough, and unconditionally so. A strictly proper section — any
    // low-pass or band-pass, where b0 is zero — genuinely has no direct term
    // and could break an algebraic loop, but feedthrough is declared by this
    // signature at compile time and a signature cannot depend on a setting
    // resolved at configuration. A strictly-proper sibling is the way to buy
    // that back, and it is deliberately not this node.
    output(x) {
        out.y = var.d0 * in.x + var.cwd * state.wd + var.cw * state.w;
    }
}
