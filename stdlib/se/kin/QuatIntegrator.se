// Integrates a quaternion RATE into an attitude, and keeps the result on the
// unit sphere.
//
// The input is `q_dot`, not an angular velocity: `se.kin.AngRateToQuatRate` is
// the block that turns a body rate into one, and keeping the two apart is what
// lets this block be an ordinary integrator rather than a special case.
//
// `output()` HAS AN EMPTY PARAMETER LIST, and that is load-bearing rather than
// an oversight. The attitude channel is a cycle --
//
//     q --> AngRateToQuatRate --> qd --> QuatIntegrator --> q
//
// -- and `AngRateToQuatRate.output(q)` declares feedthrough on `q`, so if this
// block declared any too the whole loop would be feedthrough and SPEC 8.6 would
// reject it as an algebraic loop. An empty `In_output` is a sort root (SPEC
// 8.5), which is exactly what a state variable should be: the value is already
// known when the tick starts.
//
// THE INITIAL CONDITION IS IDENTITY, not zero. All four states at zero is not a
// small rotation, it is not an attitude at all, and it is the one input the
// normalisation below cannot rescue: it turns into four NaNs.
//
// WHY `adjust()`. For `q_dot = 1/2 q (x) w` with a pure-imaginary `w`, `q_dot`
// is orthogonal to `q`, so `d|q|/dt` is exactly zero: the norm is a conserved
// quantity of the flow. It is not a conserved quantity of RK4. Nothing in the
// discrete system restores it either -- it is a free mode, neutrally stable --
// so the norm executes a random walk that no amount of step refinement bounds,
// only slows. `adjust()` (SPEC 6.4b) is the language's answer to exactly this:
// a jump map applied between steps, which pins the norm back to one without
// touching the trajectory.
//
// The ATTITUDE survives the drift regardless, which is worth knowing because it
// says what this is and is not for. The field is homogeneous of degree one in
// `q`, and `q` and `s*q` are the same rotation for any positive `s`, so a
// drifting norm cannot rotate anything wrongly -- and `QuatLog` is written to be
// scale-invariant for the same reason. What the drift does break is everything
// that reads the norm as a fact: `QuatToRot`'s formula, which is wrong off the
// unit sphere, and the recorded state, which stops meaning anything once `|q|`
// has wandered.
//
// WHY NOT ALSO NORMALISE IN `output()`. SPEC 6.4b is explicit that `adjust()`
// does not stand in for it in general -- the published value comes from the
// state the SOLVER left, one step off the manifold. Here that is not worth
// paying for. One RK4 step of a rotation at `theta = |w|*h` leaves the norm off
// by O(theta^6): at a tenth of a radian per step, seven parts in a billion,
// which is inside any tolerance a consumer would set. `output()` runs five times per step and `adjust()` runs once, so
// normalising there would cost five square roots and twenty divides per step to
// remove an error that is already negligible. A block whose rate genuinely
// approaches a radian per step should shorten its step.
//
// `adjust()` also keeps `qw >= 0`. `q` and `-q` are the same rotation, and
// holding the state in the half closest to identity is what `QuatLog` and the
// leak in `QuatLeakyIntegrator` read as "the short way back to neutral". The
// published `q` changes sign when the attitude passes a half turn.

package se.kin;

use se.kin;

node QuatIntegrator {

    inputs  { qd: kin.QuatRate; }
    outputs { q:  kin.Quat; }

    states {
        continuous qw: double(-) = 1.0;   // identity
        continuous qx: double(-) = 0.0;
        continuous qy: double(-) = 0.0;
        continuous qz: double(-) = 0.0;
    }

    derivative(qd) {
        der.qw = in.qd.w;
        der.qx = in.qd.x;
        der.qy = in.qd.y;
        der.qz = in.qd.z;
    }

    output() {
        out.q.w = state.qw;
        out.q.x = state.qx;
        out.q.y = state.qy;
        out.q.z = state.qz;
    }

    adjust() {
        const double n2 = state.qw*state.qw + state.qx*state.qx
                        + state.qy*state.qy + state.qz*state.qz;

        double k = 1.0 / std::sqrt(n2); // Force norm of 1.0
        if ( state.qw < 0 ) k *= -1;    // Force to be in branch closest to 1, i.e. keep qw positive.
        adjust.qw = state.qw * k;
        adjust.qx = state.qx * k;
        adjust.qy = state.qy * k;
        adjust.qz = state.qz * k;
    }
}
