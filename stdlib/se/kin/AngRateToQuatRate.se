package se.kin;

use se.kin;
use se.math;

node AngRateToQuatRate {

    inputs  { 
        q: kin.Quat;  
        w: math.Vec3(rad/s);   // Expressed in local (body) coordinates.
    }
    outputs { qd: kin.QuatRate; }

    // Both inputs are read, so both are listed: SPEC 8.3 makes the list the
    // set of inputs the method reads, and the generated `In_output` omits
    // anything left off it -- so a missing name is a C++ compile error at
    // this line rather than a stale value.
    output(q, w) {
        // qd = 0.5 q (x) w

        const double qw = in.q.w;
        const double qx = in.q.x;
        const double qy = in.q.y;
        const double qz = in.q.z;

        const double wx = in.w.x;
        const double wy = in.w.y;
        const double wz = in.w.z;

        out.qd.w = 0.5*( -qx*wx - qy*wy - qz*wz );
        out.qd.x = 0.5*(  qw*wx + qy*wz - qz*wy );
        out.qd.y = 0.5*(  qw*wy + qz*wx - qx*wz );
        out.qd.z = 0.5*(  qw*wz + qx*wy - qy*wx );
    }
}
