package se.sig.ct;

use se.math;

node SecondOrderLowpass {
    units { U; }

    settings {
        //                 wn^2
        // H(s) = ---------------------
        //        s^2 + 2 wn z s + wn^2
        //
        // H'(s) = s H(s)
        wn: double(rad/s);
        z: double(-);
    }

    inputs  { x: double(U); }
    outputs { 
        y:  double(U);
        yd: double(U/s); // s Y(s)
    }

    states {
        continuous w:  double(-) = 0.0;
        continuous wd: double(-) = 0.0;
    }

    vars {
        // The canonical-form coefficients, built once from `wn` and `z`. There
        // is no normalisation here and so no primed spelling: unlike
        // `SecondOrderSystem`, this node is handed a DESIGN rather than a pair
        // of polynomials, so the s^2 coefficient is 1 by construction and
        // nothing is ever divided by it.
        a1: double(-);  a0: double(-);  // denominator: s^2 + a1 s + a0
        b0: double(-);  // numerator, and the DC gain once a0 divides it out
    }

    init() {
        sim.require( param.wn > 0, "Filter break frequency 'wn' must be positive and non-zero." );
        sim.require( param.z >= 0, "Filter damping factor 'z' must be positive or zero." );
        auto wn = param.wn;
        auto wn2 = wn * wn;
        auto z  = param.z;

        var.a1 = 2 * z * wn;
        var.a0 = wn2;
        var.b0 = wn2;
    }

    derivative(x) {
        der.w  = state.wd;
        der.wd = in.x - var.a1 * state.wd - var.a0 * state.w;
    }

    output(x) {
        out.y  = var.b0 * state.w;
        out.yd = var.b0 * state.wd;
    }
}
