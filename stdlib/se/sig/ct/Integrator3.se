package se.sig.ct;

use se.math;
use se.sig.ct;

node Integrator3 {
    units { U; }

    inputs  { x: math.Vec3(U); }
    outputs { y: math.Vec3(U*s); }

    structure {
        // `mg` merges the INTEGRATED axes, so it binds `U*s` and not `U`: the
        // scalar `ct.Integrator` is U -> U*s, and a `Merge3(U)` here is an
        // SE0410 on all three wires.
        node sp: math.Split3(U) {};
        node mg: math.Merge3(U*s) {};

        // `ix`/`iy`/`iz`, not `x`/`y`/`z`: this node's own ports are named `x`
        // and `y` after the scalar `ct.Integrator`, and an instance sharing a
        // port's name is SE0330. `FirstOrderSystem3` gets away with the bare
        // axis names only because its ports are `vin`/`vout`.
        node ix: ct.Integrator(U) {};
        node iy: ct.Integrator(U) {};
        node iz: ct.Integrator(U) {};

        self --> sp;
        sp.x --> ix --> mg.x;
        sp.y --> iy --> mg.y;
        sp.z --> iz --> mg.z;
        mg  --> self;
    }
}
