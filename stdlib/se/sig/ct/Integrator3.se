package se.sig.ct;

use se.math;
use se.sig.ct;

node Integrator3 {
    units { U; }

    inputs  { x: math.Vec3(U); }
    outputs { y: math.Vec3(U*s); }

    states {
        continuous y0:  double(-) = 0.0;
        continuous y1:  double(-) = 0.0;
        continuous y2:  double(-) = 0.0;
    }

    derivative(x) {
        der.y0 = in.x.x;
        der.y1 = in.x.y;
        der.y2 = in.x.z;
    }

    output() {
        out.y.x = state.y0;
        out.y.y = state.y1;
        out.y.z = state.y2;
    }
}
