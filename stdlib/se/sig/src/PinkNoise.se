// Pink noise -- power spectral density falling as 1/f -- approximated by white
// noise through three one-pole sections in parallel.
//
// THE POLES ARE PLACED FROM DECLARED CORNER FREQUENCIES, NOT FROM TABULATED
// COEFFICIENTS. The widely-copied economy filter (Kellett's) hard-codes six
// constants tuned for 44.1 kHz; drop it into a 1 kHz model and the slope is
// wrong across the whole band, silently. Spacing the poles logarithmically
// between `f_lo` and `f_hi` and computing the coefficients in `init()` from the
// node's own rate makes the block rate-independent -- the same principle
// `se.sig.dt.Biquad` follows by taking analog coefficients and discretising
// them itself.
//
// The approximation is good to roughly +/-0.5 dB across `f_lo` to `f_hi`, which
// is about three decades for three poles. Outside that band it flattens: below
// `f_lo` to white, above `f_hi` to white. That is a property of the method, not
// a defect to tune out -- true 1/f has infinite power at DC and no realisable
// filter produces it.
//
// FIXED AT THREE POLES. A `poles` setting would be an array extent, which §6.2
// makes STRUCTURAL -- fixed at elaboration and not overridable in a compiled
// binary -- and state array extents are not implemented. Widening the band
// means adding sections, so it is a change to this file, not a knob.
//
// See `WhiteNoise` for the draw and for what `rate` does to the source
// spectrum feeding this.
package se.sig.src;

node PinkNoise {
    units { U; }

    settings {
        sigma (U): double = 1.0;      // standard deviation of the OUTPUT
        mean  (U): double = 0.0;

        f_lo (Hz): double = 1.0;      // below this the spectrum flattens
        f_hi (Hz): double = 1000.0;   // above this it flattens too

        seed (-): int = 12345;

        rate (Hz): double = sample_rate;
    }

    outputs { y (U): double; }

    states {
        discrete k (-): int = 0;

        // One per section. `(-)` because a canonical filter state has no honest
        // unit when the gains carry none -- the same reason `dt.Biquad`'s Direct
        // Form II states are dimensionless. Public surface: these are the slot
        // names an IC override addresses.
        discrete s0 (-): double = 0.0;
        discrete s1 (-): double = 0.0;
        discrete s2 (-): double = 0.0;
    }

    vars {
        p0 (-): double;  p1 (-): double;  p2 (-): double;   // pole coefficients
        g  (-): double;                                     // output normalisation
    }

    declarations {
        #include <cstdint>
        #include <cmath>
        namespace {

        // lowbias32, as in WhiteNoise. Named for THIS node -- see the note
        // there on one translation unit.
        inline std::uint32_t pn_hash(std::uint32_t x) {
            x ^= x >> 16;  x *= 0x7feb352du;
            x ^= x >> 15;  x *= 0x846ca68bu;
            x ^= x >> 16;  return x;
        }

        inline double pn_u01(std::uint32_t h) {
            return (static_cast<double>(h) + 0.5) * (1.0 / 4294967296.0);
        }

        }
    }

    double pn_draw(int seed, int k) const {
        const std::uint32_t s = static_cast<std::uint32_t>(seed) * 0x9e3779b9u;
        const std::uint32_t i = static_cast<std::uint32_t>(k) * 2u;
        const double u1 = pn_u01(pn_hash(s + i));
        const double u2 = pn_u01(pn_hash(s + i + 1u));
        return std::sqrt(-2.0 * std::log(u1)) * std::cos(6.283185307179586 * u2);
    }

    // Three poles spaced evenly in log frequency across [f_lo, f_hi], each a
    // one-pole low-pass at exp(-2*pi*fc/rate). Each section on its own rolls
    // off at -6 dB/octave above its corner; STAGGERING them a decade or so
    // apart and summing is what averages to the -3 dB/octave that 1/f power
    // means. The ripple between corners is the approximation error.
    //
    // The 2*pi is on erased units, for `LowPass2`'s reason -- see `Sine.se`.
    init() {
        const double lo = std::log(param.f_lo);
        const double hi = std::log(param.f_hi);
        const double d  = (hi - lo) * 0.5;              // two gaps, three poles

        var.p0 = std::exp(-6.283185307179586 * std::exp(lo)           / param.rate);
        var.p1 = std::exp(-6.283185307179586 * std::exp(lo + d)       / param.rate);
        var.p2 = std::exp(-6.283185307179586 * std::exp(lo + 2.0 * d) / param.rate);

        // Normalise so the output's standard deviation is `sigma` whatever the
        // poles are. Without this, moving `f_lo` silently moves the level.
        //
        // The three sections are driven by the SAME innovation, so they are
        // fully correlated and their variances DO NOT ADD -- summing
        // 1/(1 - p_i^2) would understate the level badly for closely spaced
        // poles. For jointly-driven AR(1) processes the covariance is exactly
        // Cov(s_i, s_j) = 1/(1 - p_i p_j), so the variance of the sum is the
        // full nine-term double sum. Computed once, here.
        const double p[3] = {var.p0, var.p1, var.p2};
        double v = 0.0;
        for (int i = 0; i < 3; ++i)
            for (int j = 0; j < 3; ++j) v += 1.0 / (1.0 - p[i] * p[j]);
        var.g = 1.0 / std::sqrt(v);

        if (param.f_hi >= 0.5 * param.rate)
            log.warn("f_hi = {} Hz is at or above the Nyquist of this node's {} Hz rate",
                     param.f_hi, param.rate);
        if (param.f_lo <= 0.0 || param.f_hi <= param.f_lo)
            log.error("f_lo = {} Hz and f_hi = {} Hz do not bracket a band",
                      param.f_lo, param.f_hi);
    }

    output() {
        out.y = param.mean + param.sigma * var.g * (state.s0 + state.s1 + state.s2);
    }

    // Plain leaky integrators, all fed the same standard-normal draw. The
    // level is fixed once by `var.g` in `output()` rather than by weighting
    // each input here, so the per-step cost stays one draw and three
    // multiply-adds.
    next() {
        const double w = pn_draw(param.seed, state.k);
        next.k  = state.k + 1;
        next.s0 = var.p0 * state.s0 + w;
        next.s1 = var.p1 * state.s1 + w;
        next.s2 = var.p2 * state.s2 + w;
    }
}
