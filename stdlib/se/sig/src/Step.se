// A step from `initial` to `target` at time `t_step`.
//
// The default is the unit step already high at t = 0 — `t_step = 0` — because
// that is the excitation a closed-form step response is written against: a
// source that switches one sample later shifts every reference curve by a
// step, which is a wrong answer that looks like a solver problem.
//
// This node carried its own `discrete t` clock until `sim.time()` existed
// (§10.5), on the grounds that §10.2 withheld sim time from bodies. It does
// not any more. The clock was a duplicate of a number the engine already held,
// and the one capability it offered — starting a run with the step already
// past, by overriding the state through the IC channel — is what `t_step` is
// for and says more plainly.
//
// The switch still lands on a sample instant: this node declares a `rate`, so
// its output is zero-order held and `sim.time()` reads that instant rather
// than the solver's minor step. A continuous consumer therefore sees the edge
// quantised to this node's step, and feeding an RK4 plant from anything in
// `se.sig.src` hands it a staircase. That is the trade this package makes;
// `se.sig.ct` is where the twin that does not make it lives.
package se.sig.src;

node Step {
    units { U; }

    settings {
        initial: double(U) = 0.0;
        // Not `final`: that is a reserved word (Appendix B) — the teardown
        // lifecycle method — so the far end of the step is `target`.
        target: double(U) = 1.0;
        t_step: double(s) = 0.0;

        // Reserved (§6.2): declared so an instance may be re-rated, defaulting
        // to the base step. `sample_rate` reads the base rate here — the
        // reserved setting is resolved before any other, so this is not
        // circular (§10.4).
        rate: double(Hz) = sample_rate;
    }

    outputs { y: double(U); }

    output() { out.y = sim.time() < param.t_step ? param.initial : param.target; }
}
