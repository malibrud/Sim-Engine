// A step from `initial` to `target` at time `t_step`.
//
// The default is the unit step already high at t = 0 — `t_step = 0` — because
// that is the excitation a closed-form step response is written against: a
// source that switches one sample later shifts every reference curve by a
// step, which is a wrong answer that looks like a solver problem.
//
// Time is a `discrete` state, and it has to be: §10.2 withholds sim time from
// node bodies, so a source carries its own clock. One consequence is visible
// here and is worth knowing at the use site — the switch lands on a sample
// instant, so a continuous consumer sees the edge quantised to this node's
// step. Feeding an RK4 plant from any source in this package hands it a
// staircase; that is the trade `se.sig.src` accepted by having no `ct` twin.
package se.sig.src;

node Step {
    units { U; }

    settings {
        initial (U): double = 0.0;
        // Not `final`: that is a reserved word (Appendix B) — the teardown
        // lifecycle method — so the far end of the step is `target`.
        target  (U): double = 1.0;
        t_step  (s): double = 0.0;

        // Reserved (§6.2): declared so an instance may be re-rated, defaulting
        // to the base step. `sample_rate` reads the base rate here — the
        // reserved setting is resolved before any other, so this is not
        // circular (§10.4).
        rate (Hz): double = sample_rate;
    }

    outputs { y (U): double; }

    // Elapsed time. Public surface: the IC channel reaches it (§13.4), so a
    // sim file can start a run with the step already past.
    states { discrete t (s): double = 0.0; }

    // The node's own sample period. A `var` rather than a setting: `param.rate`
    // already carries the rate, and a second `ts` setting would put a derived
    // duplicate of it in the configuration schema (§15.6) for a reader to
    // override out of sync.
    vars { ts (s): double; }

    init() { var.ts = 1.0 / param.rate; }

    output() { out.y = state.t < param.t_step ? param.initial : param.target; }

    next() { next.t = state.t + var.ts; }
}
