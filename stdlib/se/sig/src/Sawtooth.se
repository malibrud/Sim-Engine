// A rising sawtooth: `-amplitude` at u = 0, climbing linearly to `+amplitude`
// just before the turn, then snapping back.
//
// Bipolar and zero-mean for `Square`'s reason. Note that this one is NOT
// phase-aligned with `Sine` and cannot be: a sawtooth's defining feature is
// that it starts a period at its minimum, so u = 0 is the bottom of the ramp
// rather than a zero crossing. `phase = pi (rad)` puts the discontinuity at
// u = 0 instead, if the edge placement matters more than the start value.
//
// The falling sawtooth is `amplitude = -A`, not a second node.
package se.sig.src;

node Sawtooth {
    units { U; }

    settings {
        amplitude: double(U)   = 1.0;
        f:         double(Hz)  = 1.0;
        phase:     double(rad) = 0.0;
        offset:    double(U)   = 0.0;

        rate: double(Hz) = sample_rate;
    }

    outputs { y: double(U); }

    states { discrete u: double(-) = 0.0; }

    vars { du: double(-);  p0: double(-); }

    init() {
        var.du = param.f / param.rate;
        var.p0 = param.phase / 6.283185307179586;   // see Sine.se on the 2*pi
        if (param.f >= 0.5 * param.rate)
            log.warn("f = {} Hz is at or above the Nyquist of this node's {} Hz rate",
                     param.f, param.rate);
    }

    output() {
        const double w = state.u + var.p0;
        const double p = w - std::floor(w);
        out.y = param.offset + param.amplitude * (2.0 * p - 1.0);
    }

    next() {
        const double v = state.u + var.du;
        next.u = v - std::floor(v);
    }
}
