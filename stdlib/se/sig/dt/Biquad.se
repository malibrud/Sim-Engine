// The core of the filter library: one second-order section, specified by its
// ANALOG coefficients and realized here by the bilinear transform.
//
// Taking analog rather than pre-transformed discrete coefficients is what makes
// the design layer (LowPass2, HighPass2, ...) realization-agnostic: every design
// computes an s-domain numerator and denominator and hands them here. That is
// what let `ct.SecondOrderSystem` consume the identical spec without touching any design,
// and it is why the two share a name rather than a prefix.
//
// Instantiate this directly to enter H(s) yourself:
//
//     node hp : se.sig.dt.Biquad (m/s^2) {
//         a0 = 1.0;  a1 = 8.68;  a2 = 9.61;      // s^2 + 8.68 s + 9.61
//         b0 = 1.0;  b1 = 0.0;   b2 = 0.0;       // s^2          -> high-pass
//     };
package se.sig.dt;

node Biquad {
    units { U; }

    settings {
        // H(s) = (b0 s^2 + b1 s + b2) / (a0 s^2 + a1 s + a2).
        //
        // Declared `(-)` because a continuous coefficient array has per-element
        // units — a1 is T^-1, a2 is T^-2 — which there is no honest way to
        // spell. The dimensional contract lives entirely in the ports: this
        // node is U -> U, and nothing about the coefficients can change that.
        a0: double(-) = 1.0;
        a1: double(-) = 0.0;
        a2: double(-) = 0.0;
        b0: double(-) = 0.0;
        b1: double(-) = 0.0;
        b2: double(-) = 1.0;

        // This node's own rate, not the base step — coefficients designed at
        // the wrong rate are silently wrong.
        fs: double(Hz) = sample_rate;
    }

    inputs  { x: double(U); }
    outputs { y: double(U); }

    // Direct Form II. Two states whatever the section is; a first-order design
    // does NOT belong here — see Integrator, Differentiator and HighPass1.
    states {
        discrete w1: double(-) = 0.0;
        discrete w2: double(-) = 0.0;
    }

    vars {
        da1: double(-);  da2: double(-);
        db0: double(-);  db1: double(-);  db2: double(-);
    }

    // Bilinear transform, s -> K (1 - z^-1) / (1 + z^-1) with K = 2 fs, then
    // normalised so the discrete a0 is 1.
    init() {
        const double K1 = 2.0 * param.fs;
        const double K2 = K1 * K1;

        const double A0 =  K2 * param.a0 + K1 * param.a1 + param.a2;
        const double A1 = -2.0 * K2 * param.a0            + 2.0 * param.a2;
        const double A2 =  K2 * param.a0 - K1 * param.a1 + param.a2;

        const double B0 =  K2 * param.b0 + K1 * param.b1 + param.b2;
        const double B1 = -2.0 * K2 * param.b0            + 2.0 * param.b2;
        const double B2 =  K2 * param.b0 - K1 * param.b1 + param.b2;

        var.da1 = A1 / A0;  var.da2 = A2 / A0;
        var.db0 = B0 / A0;  var.db1 = B1 / A0;  var.db2 = B2 / A0;
    }

    // Feedthrough: the bilinear transform gives db0 != 0 even for a low-pass,
    // so this section cannot break an algebraic loop.
    output(x) {
        const double w0 = in.x - var.da1 * state.w1 - var.da2 * state.w2;
        out.y = var.db0 * w0 + var.db1 * state.w1 + var.db2 * state.w2;
    }

    next(x) {
        const double w0 = in.x - var.da1 * state.w1 - var.da2 * state.w2;
        next.w1 = w0;
        next.w2 = state.w1;
    }
}
