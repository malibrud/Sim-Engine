package drivetrain;

// Registered discrete consumer: watches the record's slip, commands a torque cut.
node TractionController {
    settings {
        rate:       double(Hz)  = 200.0;  // integer decimation of the base step
        slip_limit: double(-)   = 0.10;
        gain:       double(N*m) = 400.0;  // torque cut per unit of excess slip
    }
    inputs {
        ws: WheelState;  // the whole record arrives on one wire
    }
    outputs {
        torque_cut: double(N*m);
    }
    states {
        discrete cut: double(N*m) = 0.0;  // IC is declarative -- no init() needed
    }

    // update at the 200 Hz sample tick; `next.` makes it simultaneous, order-independent.
    // `ws` is listed because the body reads it -- but next() runs after outputs have
    // propagated, so unlike output() this constrains nothing for the sort.
    next(ws) {
        auto excess = in.ws.slip - param.slip_limit;                 // dimensionless
        // plain double: units are checked at declarative sites and erased, so a
        // zero is just a zero -- no `0.0 * (N*m)` literal ceremony.
        next.cut = excess > 0.0 ? param.gain * excess : 0.0;
    }

    // no feedthrough -> sort root -> this is the registered loop-breaker
    output() {
        out.torque_cut = state.cut;
    }
}
