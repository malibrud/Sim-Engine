package drivetrain;

// Continuous producer: integrates wheel speed, packs a WheelState record.
node Wheel {
    settings {
        inertia: double(kg*m^2) = 0.9;
        radius:  double(m)      = 0.31;
    }
    inputs {
        drive_torque: double(N*m);  // from the driveline
        ground_speed: double(m/s);  // vehicle longitudinal speed
    }
    outputs {
        ws: WheelState;  // the whole record leaves on one wire
    }
    states {
        continuous omega: double(rad/s) = 0.0;
    }
    vars {
        inertia_inv: double(1/(kg*m^2));
    }

    init() {
        var.inertia_inv = 1.0 / param.inertia;
    }

    // continuous dynamics: I*omega_dot = tau
    // der.omega is (rad/s^2), derived from the state's unit -- never declared.
    derivative(drive_torque) {
        der.omega = in.drive_torque * var.inertia_inv;
    }

    // pack the record; reads inputs -> feedthrough on both, declared by signature.
    // accessors arrive as plain double, guaranteed by the generator to be in the
    // unit declared above. body arithmetic is NOT dimension-checked -- units are
    // checked by the DSL at declarative sites (ports, wires, settings) and erased.
    output(drive_torque, ground_speed) {
        auto surface_speed = state.omega * param.radius;              // (m/s)
        out.ws.speed  = state.omega;
        out.ws.torque = in.drive_torque;
        out.ws.slip   = (surface_speed - in.ground_speed) / in.ground_speed;  // guard omitted
    }
}
