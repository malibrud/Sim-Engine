// Driving over an obstacle, as the washout repo's validation suite drives it:
// `obstacle_pitch_heave` in validation/maneuvers.h, golden run
// validation/golden/Classical__obstacle_pitch_heave.csv.
//
// The nose comes up and the vehicle rises, then the nose goes down and it
// falls: from t = 2, 1 s of +0.4 rad/s pitch with 1 m/s^2 up (-Z), then 1 s
// of -0.4 rad/s with 1 m/s^2 down, level and at rest again at t = 4. Its
// pitch peaks at 0.4 rad at t = 3. Each axis is two pulses and a `math.Sum`,
// because a wire has one producer. Ditch.se is the same with every sign
// reversed.
package washout;

use se.math;
use se.kin;
use se.sig;

node ObstaclePitchHeave {
    settings {
        t_start:   double(s)     = 2.0;
        half:      double(s)     = 1.0;
        pitchRate: double(rad/s) = 0.4;
        heave:     double(m/s^2) = 1.0;
    }

    structure {
        node q1: sig.src.RectPulse (rad/s) {
            t_start    = param.t_start;
            t_duration = param.half;
            amplitude  = param.pitchRate;
        };
        node q2: sig.src.RectPulse (rad/s) {
            t_start    = param.t_start + param.half;
            t_duration = param.half;
            amplitude  = -param.pitchRate;
        };
        node az1: sig.src.RectPulse (m/s^2) {
            t_start    = param.t_start;
            t_duration = param.half;
            amplitude  = -param.heave;
        };
        node az2: sig.src.RectPulse (m/s^2) {
            t_start    = param.t_start + param.half;
            t_duration = param.half;
            amplitude  = param.heave;
        };
        node q:  math.Sum(rad/s);
        node az: math.Sum(m/s^2);
        node pitch: sig.ct.Integrator (rad/s);
        node ain: math.Merge3(m/s^2);
        node win: math.Merge3(rad/s);
        node wdin: math.Merge3(rad/s^2);
        node att: math.Merge3(rad);
        node qin: kin.EulerToQuat {};
        node wash: washout.Classical {};

        q1 --> q.a;    q2 --> q.b;
        az1 --> az.a;  az2 --> az.b;

        0.0 --> ain.x, ain.y;
        az --> ain.z;
        0.0 --> win.x, win.z;
        q --> win.y;
        // The rate steps, so its true derivative is an impulse at each
        // edge. Zero stands in for it exactly only because `headPos` is 0
        // here, and with no lever arm `wdin` multiplies nothing.
        0.0 --> wdin.x, wdin.y, wdin.z;
        // The attitude is the rate integrated from level: one axis at a
        // time, so the Euler rate and the body rate are the same thing.
        q --> pitch --> att.y;
        0.0 --> att.x, att.z;

        ain --> wash.ain;
        win --> wash.win;
        wdin --> wash.wdin;
        att --> qin --> wash.qin;
    }
}
