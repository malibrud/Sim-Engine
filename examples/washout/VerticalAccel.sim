// Reid & Nahon's heave test, to overlay on the washout repo's golden run
// validation/golden/Classical__vertical_accel.csv. Same drive, same 40 s,
// same 100 Hz in the file, same g (RN85.settings). See LongitudinalAccel.sim
// for the half sample between the golden's rows and these.
sim VerticalAccel {
    root: washout.VerticalAccel {};

    step:     1 (ms);
    solver:   rk4;
    duration: 40 (s);

    settings: "RN85.settings";

    record: {
        file:  "vertical_accel.csv";
        every: 10;           // 100 Hz, the golden's rate

        signals {
            // The drive: 2 m/s^2 along +Z, which is DOWN, 0-10 s.
            pulse.y;

            // The translational channel -- golden `out_acc_*`, `out_vel_*`,
            // `out_pos_*` -- on all three axes, and all nine overlay.
            //
            // Z is the pure high-pass response, the one the other cases are
            // variations on. The platform never leans, so the gravity term is
            // {0, 0, g} throughout and cancels the -g inside `sf` exactly: the
            // channel sees the 2 m/s^2 step alone, `aout.z` leaves at the full
            // 2 (the golden's first row, half a sample later, at 1.91), and
            // the platform goes down to 0.148 m at t = 1.85 and up to -0.124 m
            // at t = 11.98 and ends 0.5 mm from home. 1.8e-3 m/s^2, 1.9e-4 m/s
            // and 3.1e-5 m from the golden once its half sample is allowed
            // for, away from the two edges.
            //
            // X and Y: zero on every row, in both. With no lean there is no
            // frame rotation to move anything off the driven axis.
            wash.aout.x;
            wash.aout.y;
            wash.aout.z;
            wash.vout.x;
            wash.vout.y;
            wash.vout.z;
            wash.pout.x;
            wash.pout.y;
            wash.pout.z;

            // The commanded attitude and its rate: zero on every row, exactly,
            // here and in the golden. Z has no tilt to lean into -- `TiltCalc`
            // takes X and Y only -- so heave is cued by translation alone. A
            // nonzero cell in any of these six is a leak between channels.
            wash.ecmd.x;
            wash.ecmd.y;
            wash.ecmd.z;
            wash.wcmd.x;
            wash.wcmd.y;
            wash.wcmd.z;
        }
    }
}
