// Reid & Nahon's surge test, to overlay on the washout repo's golden run
// validation/golden/Classical__longitudinal_accel.csv. Same drive, same 40 s,
// same 100 Hz in the file, same g (RN85.settings).
//
// The golden is a DISCRETE run: 100 Hz filters by the bilinear transform, so its
// sample i sits about half a sample (5 ms) later in continuous time than this
// file's row i. Everything below that says "overlays" was measured against it,
// and the half sample is the whole of the difference.
sim LongitudinalAccel {
    root: washout.LongitudinalAccel {};

    step:     1 (ms);
    solver:   rk4;
    duration: 40 (s);

    settings: "RN85.settings";

    record: {
        file:  "longitudinal_accel.csv";
        every: 10;           // 100 Hz, the golden's rate

        signals {
            // The drive: 2 m/s^2 forward, 0-10 s.
            pulse.y;

            // The translational channel -- golden `out_acc_*`, `out_vel_*`,
            // `out_pos_*` -- on all three axes, and all nine overlay.
            //
            // X: 1.9e-3 m/s^2, 1.8e-4 m/s and 3.6e-5 m from the golden once
            // its half sample is allowed for, away from the two edges. The
            // gravity term is what shapes it. Without that term this was the
            // golden HEAVE run, the same step through the same filters; with
            // it, the lean's share of gravity comes back out of the channel
            // as the lean builds, so `aout.x` undershoots to -0.328 at
            // t = 0.47, the platform goes out to 0.079 m at t = 0.86, and the
            // ride ends 2.4 cm from home -- all three as in the golden.
            //
            // Z is the frame rotation, and nothing drives it. It starts while
            // the lean builds under the onset transient -- 0.049 m by t = 10
            // -- and the release transient arrives with the full lean on, so
            // more of it lands in inertial Z: 0.41 m/s^2 at t = 10. A
            // transient rotated while the rotation changes has lost the zero
            // net area the local high pass gave it, so the first-order global
            // high pass brings the velocity home and not the position: the
            // platform ends 0.116 m low (+Z is down) and stays there, in both
            // runs, to 1.2e-5 m.
            //
            // Y: zero on every row, in both.
            wash.aout.x;
            wash.aout.y;
            wash.aout.z;
            wash.vout.x;
            wash.vout.y;
            wash.vout.z;
            wash.pout.x;
            wash.pout.y;
            wash.pout.z;

            // The commanded attitude -- golden `out_roll (PHIS)`,
            // `out_pitch (THETAS)`, `out_yaw (PSIS)`, and these DO overlay.
            // Pitch leans nose-up to asin(2/9.81) = 0.2053 rad, 99% there by
            // t = 3.7, holds it for the rest of the pulse, and comes back
            // after it: 3e-5 rad from the golden once the half sample is
            // allowed for, 9e-4 without. Roll and heading are zero in both.
            wash.ecmd.x;
            wash.ecmd.y;
            wash.ecmd.z;

            // Its body rate -- golden `out_p (PS)`, `out_q (QS)`,
            // `out_r (RS)`. Pure tilt rate here: 0.183 rad/s at t = 0.29 and
            // -0.186 at t = 10.28. The release peak is the larger because the
            // arcsine's slope, 1/cos(tilt), is steeper at 0.2 rad than at 0,
            // and the golden shows the same 0.186. 2e-4 rad/s from it once
            // the half sample is allowed for, away from the two edges; 9e-3
            // without, all of it the half sample on a rate that moves
            // 1.7 rad/s^2 just after each edge.
            wash.wcmd.x;
            wash.wcmd.y;
            wash.wcmd.z;
        }
    }
}
