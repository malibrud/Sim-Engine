package washout;

use se.math;
use se.sig;

node PulseX {
    settings {
    }

    structure {
        node pulse: sig.src.RectPulse (m/s^2);
        node ain: math.Merge3(m/s^2);
        node win: math.Merge3(m/s^2);
        node wash: washout.ClassicalFromScratch {
        };

        pulse --> ain.x;
        0.0 --> ain.y, ain.z;
        0.0 --> win.x, win.y, win.z;

        ain --> wash.ain;
        win --> wash.win;
    }
}
