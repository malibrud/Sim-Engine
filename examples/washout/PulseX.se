package washout;

use se.math;
use se.kin;
use se.sig;

node PulseX {
    settings {
        duration: double(s) = 10.0;
        amplitude: double(m/s^2) = 2.0;
    }

    structure {
        node pulse: sig.src.RectPulse (m/s^2) {
            t_duration = param.duration;
            amplitude = param.amplitude;
        };
        node ain: math.Merge3(m/s^2);
        node win: math.Merge3(rad/s);
        node wdin: math.Merge3(rad/s^2);
        node att: math.Merge3(rad);
        node qin: kin.EulerToQuat {};
        node wash: washout.Classical {
        };

        pulse --> ain.x;
        0.0 --> ain.y, ain.z;
        0.0 --> win.x, win.y, win.z;
        0.0 --> wdin.x, wdin.y, wdin.z;
        // Level throughout: the identity attitude, so no gravity is leaned.
        0.0 --> att.x, att.y, att.z;

        ain --> wash.ain;
        win --> wash.win;
        wdin --> wash.wdin;
        att --> qin --> wash.qin;
    }
}
