// A slalom, to overlay on the washout repo's golden run
// validation/golden/Classical__slalom.csv. Same drive, same 30 s, same 100 Hz
// in the file, same g (RN85.settings).
//
// SteadyCornering's turn, reversed every 2.5 s for four cycles, and
// SteadyCornering.sim says what each column checks. What this case adds is the
// reversal: every flip reverses the yaw rate while the full lean is still on,
// which is the transport's hardest moment, seven times over.
sim Slalom {
    root: washout.Slalom {};

    step:     1 (ms);
    solver:   rk4;
    duration: 30 (s);

    settings: "RN85.settings";

    record: {
        file:  "slalom.csv";
        every: 10;           // 100 Hz, the golden's rate

        signals {
            // The drive: +0.3 rad/s with +3 m/s^2, right, from t = 2, flipping
            // sign together every 2.5 s until t = 22. Every sample equals the
            // golden's `in_w_z` and `in_sf_y`.
            drive.r;
            drive.ay;

            // Translation, all nine columns, overlaying the golden as in
            // SteadyCornering. Y swings from -0.227 m at t = 5.36 to +0.308 m
            // at t = 17.93 and ends 0.073 m out; 7.1e-3 m/s^2, 6.2e-4 m/s and
            // 1.9e-4 m from the golden allowing its half sample.
            //
            // X and Z are the finding. YawCornerLeftRight shows the off-axis
            // drift keeping its sign through a reversal; here there are seven
            // reversals and the lean, the heading and the push flip together
            // every time, so what the frame rotation puts into inertial X and
            // Z is RECTIFIED -- mostly one-signed for 20 s. The first-order
            // global high pass turns a sustained acceleration into a
            // sustained velocity, and the platform walks: 4.60 m low and
            // 3.98 m forward at t = 30, still moving. That is the classical
            // washout's, not this port's -- the golden does it too, Z to
            // 4.6e-4 m -- and X is 0.9% from it, 3.6e-2 m, the golden's
            // one-sample heading lead again (SteadyCornering.sim).
            wash.aout.x;
            wash.aout.y;
            wash.aout.z;
            wash.vout.x;
            wash.vout.y;
            wash.vout.z;
            wash.pout.x;
            wash.pout.y;
            wash.pout.z;

            // The commanded attitude. 2.5 s is too short for the tilt to settle
            // at 0.3108: roll reaches -0.2956 by the first flip, and +-0.2816
            // at every one after, where it has nearly twice as far to swing.
            // 1e-4 rad from the golden allowing its half sample. Pitch is zero
            // in both, to 1e-17. Heading ranges from -0.193 at t = 5.48 to
            // +0.173 at 13.05, one sample earlier in the golden and 1.2e-4
            // from it allowing that sample.
            wash.ecmd.x;
            wash.ecmd.y;
            wash.ecmd.z;

            // The body rate, all within 6.3e-4 rad/s of the golden allowing its
            // half sample. q = tan(roll) * r, to 1e-9, and it is NOSE-UP at
            // every flip whichever way the flip goes: the lean has the sign
            // opposite to the old turn and the new rate the sign opposite to
            // the old rate, so the product is positive. A 0.6 rad/s step in r
            // takes q to 0.186-0.188 at each of the seven reversals; the last
            // edge, t = 22, is a 0.3 rad/s step and gives 0.103. 2.5e-5 from
            // `out_q`.
            wash.wcmd.x;
            wash.wcmd.y;
            wash.wcmd.z;
        }
    }
}
