// Reid & Nahon's vertical (heave) standard test, as the washout repo's
// validation suite drives it: `vertical_accel` in validation/maneuvers.h,
// golden run validation/golden/Classical__vertical_accel.csv.
//
// A 2 m/s^2 acceleration along +Z -- DOWN, in SAE -- from t = 0, held 10 s,
// vehicle level.
package washout;

use se.math;
use se.sig;

node VerticalAccel {
    settings {
        duration:  double(s)     = 10.0;
        amplitude: double(m/s^2) = 2.0;
    }

    structure {
        node pulse: sig.src.RectPulse (m/s^2) {
            t_duration = param.duration;
            amplitude  = param.amplitude;
        };
        node ain: math.Merge3(m/s^2);
        node win: math.Merge3(rad/s);
        node wash: washout.Classical {};

        pulse --> ain.z;
        0.0 --> ain.x, ain.y;
        0.0 --> win.x, win.y, win.z;

        ain --> wash.ain;
        win --> wash.win;
    }
}
