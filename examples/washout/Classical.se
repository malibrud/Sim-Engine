// Classical washout — the three-channel motion-cueing filter, from the library.
//
// A motion platform has a metre of travel and a vehicle has a road. The
// classical washout is how the first stands in for the second: sustained
// acceleration is cued by LEANING the platform into gravity (the tilt channel),
// transient acceleration is cued by MOVING it and then sliding it back below
// the perception threshold (the translational channel), and rotation is cued by
// turning it and letting the turn decay (the rotation channel).
//
// Ported from the C++ in the `washout` repo, block for block, with the library
// doing the filtering: `sig.ScaleLimit3` for the per-axis gain and clamp,
// `sig.ct.SecondOrderSystem3` and `ct.FirstOrderSystem3` for the high passes,
// two `ct.Integrator3` for the two integrations, and `kin.QuatLeakyIntegrator`
// for the rotation channel's washout attitude.
//
// THE CHANNELS, and what each output means:
//
//   translational   ain -> scale/limit -> f = a - g -> local high pass ->
//                   global high pass -> `aout`, then integrated to `vout` and
//                   `pout`. The high passes are why a step in `ain` comes out
//                   as a pulse: the platform moves, then washes back.
//
//   tilt            the X and Y accelerations, low passed, become the steady
//                   lean that stands in for them -- `TiltCalc` inverts
//                   a = g*sin(tilt) -- and `kin.EulerToQuat` puts that lean in
//                   the form the attitude channel wants: `qTilt`.
//
//   rotation        win -> scale/limit -> high pass -> a quaternion integrator
//                   whose leak returns it to neutral: `qWash`.
//
// THE COMMANDED ATTITUDE is the two composed, `qCmd = qWash (x) qTilt`, and it
// leaves as `qcmd`, as Euler angles `ecmd`, and with its body rate `wcmd`. The
// tilt is on the RIGHT: it leans the platform within the frame the rotation
// channel has already turned it to, which is the C++'s choice and the reason
// `MulQuatQuat`'s header gives for order mattering. Its body rate follows:
//
//     wcmd = R(qTilt)^T * (w_hp - wc*log qWash)  +  w_tilt
//
// the washout's own rate, carried through the tilt into the commanded frame,
// plus the tilt's rate. `rotQ.wleak` supplies the leak half of the first term
// and `kin.EulerRateToAngRate` the second; each factor is its own node so each
// can be read against washout_Classical.h:365-398.
//
// The translational channel does not use `qCmd` yet: it subtracts a CONSTANT
// `grav`, where the C++ adds gravity resolved through the commanded attitude to
// cancel the cue the tilt already gives. Until it does, a sustained X or Y
// acceleration is cued twice -- once by the lean and once, until the high
// passes wash it, by the platform.
//
// COORDINATE CONVENTION -- SAE, matching `se.math.Vec3`: X forward/north, Y
// right/east, Z down.
//
// `ain` is KINEMATIC acceleration and carries NO gravity: a vehicle at rest and
// level drives {0, 0, 0}, not {0, 0, -9.81}. The `sf` node subtracts `grav` to
// form the specific force an accelerometer would read, f = a - g, which at rest
// and level is {0, 0, -9.80665}. So the 1 g lives INSIDE this node and never at
// its boundary. Reading it the other way round -- and the earlier draft of this
// comment did -- makes `sf` come out at -2 g, which the high-pass then washes
// away, so nothing downstream complains and the CSV looks fine.
//
// The compiler does not check any of this and cannot (see `Vec3.se`); the
// contract with whoever drives the boundary is this comment and nothing else.
package washout;

use se.math;
use se.sig;
use se.kin;

node Classical {
    settings {
        trnGain:  math.Vec3(-)      = { 1.0, 1.0, 1.0 };
        trnLimit: math.Vec3(m/s^2)  = { 10.0, 10.0, 10.0 };

        tltGain:  double(-)      = 1.0;

        rotGain: math.Vec3(-)      = { 1.0, 1.0, 1.0 };
        rotLimit: math.Vec3(rad/s) = { 2.0, 2.0, 2.0 };
        // The rotation channel's washout corner: how fast the accumulated
        // attitude returns to neutral. `ROT_LEAK` in the C++.
        rotLeak: double(rad/s) = 0.12;

        grav:  math.Vec3(m/s^2)  = { 0.0, 0.0, 9.80665 };
        headPos: math.Vec3(m) = { 0.0, 0.0, 0.0 };
    }

    inputs  {
        ain:  math.Vec3(m/s^2); // kinematic acceleration, vehicle body frame,
                                //   gravity-free -- see the note above
        win:  math.Vec3(rad/s); // Local angular velocity
    }
    // High-passed, so whatever DC `sf` carries is gone by the time it gets
    // here: the constant -g contributes a startup transient and nothing else.
    outputs {
        aout: math.Vec3(m/s^2);// commanded platform acceleration
        vout: math.Vec3(m/s);  // commanded platform velocity
        pout: math.Vec3(m);    // commanded platform position

        qcmd: kin.Quat;        // commanded platform attitude, qWash (x) qTilt
        ecmd: math.Vec3(rad);  // the same, as SAE (roll, pitch, heading)
        wcmd: math.Vec3(rad/s);// commanded platform body rate
    }

    structure {

        //----------------------------------
        // Tilt Coordination Channel Nodes
        //----------------------------------

        node xyAccel: math.Vec3GetXY(m/s^2) {};
        node tiltScale : math.Scale2 (m/s^2, -) {
            k  = param.tltGain;
        };

        node tiltLocalFilt: sig.ct.SecondOrderLowpass2 (m/s^2) {
            wn = 3.1(rad/s);
            z = 1.4;
        };
        node tiltCalc: TiltCalc {};
        node tiltQuat: kin.EulerToQuat {};

        //----------------------------------
        // Rotation Channel Nodes
        //----------------------------------

        node rotScale : sig.ScaleLimit3 (rad/s) {
            gain  = param.rotGain;
            limit = param.rotLimit;
        };

        node rotLocalFilt: sig.ct.SecondOrderSystem3 (rad/s) {
            // s^2 / (s^2 + 2*zeta*wn*s + wn^2), wn = 1.02 rad/s, zeta = 1.0
            A = { 1.0, 2.04, 1.0404 };
            B = { 1.0, 0.0,  0.0  };
        };

        // The leak is the whole rotation channel's washout: `QuatIntegrator`
        // with the return-to-neutral folded in, so the cycle stays inside one
        // leaf and this graph has none.
        node rotQ: kin.QuatLeakyIntegrator {
            wc = param.rotLeak;
        };

        //----------------------------------
        // Commanded Attitude Nodes
        //----------------------------------

        node qCmd: kin.MulQuatQuat {};            // qWash (x) qTilt
        node eCmd: kin.QuatToEuler {};

        node wWash:  math.Diff3 (rad/s);          // w_hp - wc*log qWash
        node tiltR:  kin.QuatToRot {};
        node wWashT: kin.MulRotInvVec (rad/s);    // R(qTilt)^T * wWash
        node wTilt:  kin.EulerRateToAngRate {};
        node wCmd:   math.Sum3 (rad/s);

        //----------------------------------
        // Translational Channel Nodes
        //----------------------------------

        node transScale : sig.ScaleLimit3 (m/s^2) {
            gain  = param.trnGain;
            limit = param.trnLimit;
        };
        node sf: math.Diff3 (m/s^2);

        node transLocalFilt: sig.ct.SecondOrderSystem3 (m/s^2) {
            // s^2 / (s^2 + 2*zeta*wn*s + wn^2), wn = 3.1 rad/s, zeta = 1.4
            A = { 1.0, 8.68, 9.61 };
            B = { 1.0, 0.0,  0.0  };
        };

        node transGlobalAcc: sig.ct.FirstOrderSystem3 (m/s^2) {
            A = { 1.0, 0.2 };
            B = { 1.0, 0.0 };
        };

        // PLAIN integrators, as washout_Classical.h:443-450 has them, so that
        // `vout` is the integral of `aout` and `pout` of `vout`. The washing
        // is the high passes' job and they have done it: `aout` is already
        // third-order high passed. This one was a `LeakyIntegrator3` at
        // 0.2 rad/s -- the global high pass's own pole, applied a second
        // time -- which left `aout` alone and put `pout` up to 7.5 cm from
        // what the C++ integrates out of the same `aout` (VerticalAccel.sim
        // has the comparison).
        node transGlobalVel: sig.ct.Integrator3 (m/s^2);

        node transGlobalPos: sig.ct.Integrator3 (m/s);

        //----------------------------------
        // Signal Flow Connections
        //----------------------------------

        // Tilt Channel
        self.ain --> xyAccel --> tiltScale --> tiltLocalFilt;
                                               tiltLocalFilt.vout  --> tiltCalc.acc;
                                               tiltLocalFilt.voutd --> tiltCalc.accRate;
        tiltCalc.tilt --> tiltQuat;

        // Rotational Channel
        self.win --> rotScale --> rotLocalFilt --> rotQ;

        // Commanded Attitude
        rotQ.q   --> qCmd.q1;
        tiltQuat --> qCmd.q2;
        qCmd --> self.qcmd;
        qCmd --> eCmd --> self.ecmd;

        // Commanded Body Rate
        rotLocalFilt  --> wWash.a;
        rotQ.wleak    --> wWash.b;
        tiltQuat --> tiltR --> wWashT.R;
        wWash                --> wWashT.v;
        tiltCalc.tilt     --> wTilt.e;
        tiltCalc.tiltRate --> wTilt.ed;
        wWashT --> wCmd.a;
        wTilt  --> wCmd.b;
        wCmd --> self.wcmd;

        // Translational Channel
        self.ain --> transScale  --> sf.a;
        param.grav               --> sf.b;
        sf --> transLocalFilt --> transGlobalAcc --> transGlobalVel --> transGlobalPos;
                                  transGlobalAcc                                       --> self.aout;
                                                     transGlobalVel                    --> self.vout;
                                                                        transGlobalPos --> self.pout;
    }
}
