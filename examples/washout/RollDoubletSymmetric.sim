// A symmetric roll doublet, to overlay on the washout repo's golden run
// validation/golden/Classical__roll_doublet_symmetric.csv. Same drive, same
// 40 s, same 100 Hz in the file, same g (RN85.settings). RollDoublet.sim says
// what to allow for: the golden's attitude is a sample early, its filters
// half a sample late.
//
// RollDoublet's roll to 1 rad, then back to level by t = 5: the vehicle's lean
// is a 5 s triangle, too short for the tilt channel to follow.
sim RollDoubletSymmetric {
    root: washout.RollDoubletSymmetric {};

    step:     1 (ms);
    solver:   rk4;
    duration: 40 (s);

    settings: "RN85.settings";

    record: {
        file  = "roll_doublet_symmetric.csv";
        every = 10;          // 100 Hz, the golden's rate

        // The drive: +0.4 rad/s 0-2.5 s, -0.4 rad/s 2.5-5 s, and the
        // attitude it integrates to, 1 rad at the turn and level after.
        p.y;
        roll.out.y;

        // Translation. X is zero on every row, in both. Y swings both ways
        // as the lean comes and goes -- `aout.y` +0.295 at t = 3.05 and
        // -0.196 at 5.51 -- and the platform ends 0.085 m right. Z is the
        // frame rotation again, and here it walks: the platform is still
        // going down at t = 40, 0.482 m low (+Z is down), at 5.6e-5 m/s.
        // The golden walks with it, to 0.483. All six are within 4.1e-4
        // of the golden allowing its attitude's one sample.
        wash.aout.x;
        wash.aout.y;
        wash.aout.z;
        wash.vout.x;
        wash.vout.y;
        wash.vout.z;
        wash.pout.x;
        wash.pout.y;
        wash.pout.z;

        // The commanded attitude: the platform has rolled 0.679 rad when
        // the vehicle turns back at 1 rad, then returns to level, never
        // passing it by more than 1.1e-3 (t = 14.86), and ends 1.3e-4
        // from it. 2.4e-4 rad from the golden allowing its
        // sample; pitch and heading are zero in both.
        wash.ecmd.x;
        wash.ecmd.y;
        wash.ecmd.z;

        // The body rate: +0.4 at the start, -0.498 at the reversal, where
        // the rate steps by 0.8 rad/s. Mixed alignment, as in
        // RollDoublet.sim: 2.9e-3 rad/s from the golden allowing half a
        // sample, 4.6e-4 from the 1 kHz C++.
        wash.wcmd.x;
        wash.wcmd.y;
        wash.wcmd.z;
    }
}
